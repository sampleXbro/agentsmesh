---
/**
 * The shared social card artwork, rendered at whatever size the caller asks for.
 *
 * Two sizes ship from this one source: 1200x630 for the site's Open Graph image
 * (`public/og-image.png`) and 1280x640 for the GitHub repository social preview
 * (`assets/social-preview.png`), which is what GitHub recommends. Keeping both
 * in one component means the two cards can never drift apart.
 *
 * Regenerating either is documented in the dev pages that wrap this.
 */
import HubScene from '../home/HubScene.astro';
import logo from '../../assets/logo-dark.svg';

interface Props {
  /** Card width in px. */
  width?: number;
  /** Card height in px. */
  height?: number;
}

const { width = 1200, height = 630 } = Astro.props;
---

<main class="og" style={`--og-w:${width}px; --og-h:${height}px;`}>
  <div class="og-copy">
    <img class="og-logo" src={logo.src} alt="AgentsMesh" />
    <p class="og-eyebrow">Open source · CLI + TypeScript API</p>
    <h1>One config.<br />Every AI coding tool.</h1>
    <p class="og-tagline">Sync rules, MCP servers and skills to every tool. Agents that learn.</p>
  </div>
  <div class="og-visual">
    <HubScene variant="wide" static />
  </div>
</main>

<style>
  .og {
    position: relative;
    display: grid;
    grid-template-columns: 560px 1fr;
    align-items: center;
    gap: 24px;
    width: var(--og-w);
    height: var(--og-h);
    padding: 0 48px 0 64px;
    box-sizing: border-box;
    background-image: radial-gradient(var(--sl-color-gray-5) 1.2px, transparent 1.8px);
    background-size: 28px 28px;
  }

  .og::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 70% at 78% 50%,
      color-mix(in srgb, var(--am-signal) 16%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .og-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .og-logo {
    height: 40px;
    width: auto;
    align-self: flex-start;
    margin-bottom: 14px;
  }

  .og-eyebrow {
    margin: 0;
    font-family: var(--__sl-font-mono);
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--am-signal);
  }

  h1 {
    margin: 0;
    font-size: 60px;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
  }

  .og-tagline {
    margin: 4px 0 0;
    max-width: 30ch;
    font-size: 24px;
    line-height: 1.4;
    color: var(--sl-color-gray-2);
  }

  .og-visual {
    position: relative;
    z-index: 1;
    min-width: 0;
  }
</style>
