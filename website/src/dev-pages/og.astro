---
/**
 * Source for `public/og-image.png` (1200x630), the site's Open Graph image.
 * Served only by `astro dev` at /og/ (see integrations/dev-only-routes.mjs).
 *
 * To regenerate: restart `astro dev` so the card's scoped stylesheet is not
 * stale, run `astro preferences disable devToolbar` or it renders into the
 * bottom of the frame, screenshot the viewport at exactly 1200x630, downsample
 * if your capture is 2x, then re-enable the toolbar.
 *
 * Artwork lives in components/og/SocialCard.astro and the page shell in
 * SocialCardPage.astro, both shared with /og-github so the two cannot drift.
 */
import SocialCardPage from '../components/og/SocialCardPage.astro';
---

<SocialCardPage title="AgentsMesh social card" width={1200} height={630} />
