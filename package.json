{
  "name": "agentsmesh",
  "version": "0.36.0",
  "description": "Sync AI coding agent config from one .agentsmesh source: rules, commands, agents, skills, MCP servers, hooks and permissions for Claude Code, Cursor, GitHub Copilot, Gemini CLI, Codex CLI and every other tool, plus a shared lessons memory that learns from your repo.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "author": "sampleXbro",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js",
      "default": "./dist/engine.js"
    },
    "./canonical": {
      "types": "./dist/canonical.d.ts",
      "import": "./dist/canonical.js",
      "default": "./dist/canonical.js"
    },
    "./targets": {
      "types": "./dist/targets.d.ts",
      "import": "./dist/targets.js",
      "default": "./dist/targets.js"
    },
    "./lessons": {
      "types": "./dist/lessons.d.ts",
      "import": "./dist/lessons.js",
      "default": "./dist/lessons.js"
    }
  },
  "bin": {
    "agentsmesh": "./dist/cli.js",
    "amsh": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sampleXbro/agentsmesh.git"
  },
  "homepage": "https://samplexbro.github.io/agentsmesh/",
  "bugs": {
    "url": "https://github.com/sampleXbro/agentsmesh/issues"
  },
  "scripts": {
    "agentsmesh": "node ./dist/cli.js",
    "prebuild": "tsx scripts/generate-target-catalog.ts",
    "build": "tsup",
    "pretest": "pnpm build",
    "catalog:generate": "tsx scripts/generate-target-catalog.ts",
    "catalog:verify": "tsx scripts/generate-target-catalog.ts --verify",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "flake:check": "tsx scripts/flake-check.ts",
    "flake:watch": "tsx scripts/flake-check-watch.ts",
    "test:watch": "vitest",
    "pretest:coverage": "pnpm build",
    "test:coverage": "COVERAGE=1 vitest run --coverage && tsx scripts/coverage-floor.ts",
    "test:e2e": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "lint": "eslint src tests",
    "lint:dead": "knip",
    "lint:dead:strict": "knip --strict",
    "precommit": "pnpm typecheck && pnpm lint:dead && pnpm test:coverage && pnpm lint-staged && pnpm build",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "schemas:generate": "tsx scripts/generate-schemas.ts",
    "capabilities:audit": "tsx scripts/capabilities-audit.ts",
    "capabilities:merge": "tsx scripts/merge-capability-ledger.ts",
    "capabilities:seed": "tsx scripts/seed-capability-ledger.ts",
    "capabilities:verify": "tsx scripts/capabilities-audit.ts --verify",
    "matrix:generate": "tsx scripts/render-support-matrix.ts",
    "matrix:verify": "tsx scripts/render-support-matrix.ts --verify",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only",
    "consumer-smoke": "./scripts/consumer-smoke.sh",
    "install-global": "rm -f agentsmesh-*.tgz && npm run build && npm pack && (npm uninstall -g agentsmesh 2>/dev/null || true) && npm install -g $(pwd)/agentsmesh-*.tgz"
  },
  "keywords": [
    "ai-coding",
    "ai-coding-assistant",
    "ai-agents",
    "ai-rules",
    "agent-rules",
    "agents-md",
    "claude-md",
    "claude-code",
    "cursor",
    "cursor-rules",
    "github-copilot",
    "copilot-instructions",
    "gemini-cli",
    "codex-cli",
    "windsurf",
    "cline",
    "kiro",
    "zed",
    "continue",
    "junie",
    "roo-code",
    "mcp",
    "mcp-servers",
    "mcp-config",
    "config-sync",
    "config-management",
    "agent-memory",
    "ai-agent-memory",
    "lessons",
    "developer-tools",
    "devtools",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^2.27.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/picomatch": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "knip": "^5.66.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "publint": "^0.3.18",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chokidar": "^5.0.0",
    "diff": "8.0.4",
    "picomatch": "^4.0.4",
    "smol-toml": "^1.6.1",
    "tar": "7.5.22",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.12.25",
      "flatted": "^3.4.2",
      "ip-address": "^10.3.1",
      "fast-uri": "^3.1.5",
      "vite@7.3.1": "7.3.2",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.4",
      "brace-expansion@1.1.12": "1.1.13",
      "brace-expansion@5.0.4": "5.0.5"
    }
  }
}
