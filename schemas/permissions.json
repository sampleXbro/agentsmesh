{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "allow": {
      "description": "Tool calls to allow without confirmation. Omit to leave the tools' own list alone",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "deny": {
      "description": "Tool calls to always deny. Omit to leave the tools' own list alone",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "ask": {
      "description": "Tool calls to confirm before running. Omit to leave the tools' own list alone",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "description": "AgentsMesh permissions config (.agentsmesh/permissions.yaml)",
  "title": "agentsmesh-permissions.yaml"
}
